{
    "name": "amoljadhav/php-auth-kit",
    "description": "Small, dependency-free authentication building blocks for PHP 8.2+: tokens, rate limiting and password hashing.",
    "type": "library",
    "license": "MIT",
    "authors": [
        { "name": "Amol Jadhav" }
    ],
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": { "AuthKit\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "AuthKit\\Tests\\": "tests/" }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
